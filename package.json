{
  "name": "awmservice-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "dev:student": "turbo run dev --filter=@awm/student",
    "dev:supervisor": "turbo run dev --filter=@awm/supervisor",
    "dev:department": "turbo run dev --filter=@awm/department",
    "dev:legacy": "turbo run dev --filter=@awm/legacy",
    "build": "turbo run build",
    "build:student": "turbo run build --filter=@awm/student",
    "build:supervisor": "turbo run build --filter=@awm/supervisor",
    "build:department": "turbo run build --filter=@awm/department",
    "lint": "turbo run lint"
  },
  "devDependencies": {
    "turbo": "^2"
  },
  "packageManager": "pnpm@10.30.3",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}