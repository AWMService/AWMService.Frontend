{
  "name": "awmservice-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "dev:student": "turbo run dev --filter=@awm/student",
    "dev:universal": "turbo run dev --filter=@awm/universal",
    "dev:department": "turbo run dev --filter=@awm/department",
    "dev:admin": "turbo run dev --filter=@awm/admin",
    "build": "turbo run build",
    "build:student": "turbo run build --filter=@awm/student",
    "build:universal": "turbo run build --filter=@awm/universal",
    "build:department": "turbo run build --filter=@awm/department",
    "build:admin": "turbo run build --filter=@awm/admin",
    "lint": "turbo run lint"
  },
  "devDependencies": {
    "turbo": "^2"
  },
  "packageManager": "pnpm@10.30.3",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "i18next": "^26.0.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "react-i18next": "^17.0.1"
  }
}
